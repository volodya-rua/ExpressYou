{
  "manifest_version": 3,
  "name": "ExpressYou",
  "version": "1.3",
  "description": "Send your own memes and GIFs from a GitHub repo in Instagram, Discord, WhatsApp, Telegram, Messenger, X, Slack, Teams and more.",
  "action": { "default_popup": "popup.html" },
  "background": { "service_worker": "background.js" },
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": [
    "https://www.instagram.com/*", "https://discord.com/*", "https://*.discord.com/*", "https://web.whatsapp.com/*",
    "https://web.telegram.org/*", "https://www.messenger.com/*", "https://www.facebook.com/*",
    "https://x.com/*", "https://twitter.com/*", "https://app.slack.com/*",
    "https://teams.microsoft.com/*", "https://teams.live.com/*", "https://teams.cloud.microsoft/*",
    "https://chat.google.com/*", "https://messages.google.com/*", "https://www.linkedin.com/*",
    "https://www.reddit.com/*", "https://chat.reddit.com/*", "https://www.snapchat.com/*", "https://web.snapchat.com/*"
  ],
  "content_scripts": [{
    "matches": [
      "https://www.instagram.com/*", "https://discord.com/*", "https://*.discord.com/*", "https://web.whatsapp.com/*",
      "https://web.telegram.org/*", "https://www.messenger.com/*", "https://www.facebook.com/*",
      "https://x.com/*", "https://twitter.com/*", "https://app.slack.com/*",
      "https://teams.microsoft.com/*", "https://teams.live.com/*", "https://teams.cloud.microsoft/*",
      "https://chat.google.com/*", "https://messages.google.com/*", "https://www.linkedin.com/*",
      "https://www.reddit.com/*", "https://chat.reddit.com/*", "https://www.snapchat.com/*", "https://web.snapchat.com/*"
    ],
    "js": ["paste.js", "content.js"]
  }],
  "web_accessible_resources": [{
    "resources": ["popup.html"],
    "matches": [
      "https://www.instagram.com/*", "https://discord.com/*", "https://*.discord.com/*", "https://web.whatsapp.com/*",
      "https://web.telegram.org/*", "https://www.messenger.com/*", "https://www.facebook.com/*",
      "https://x.com/*", "https://twitter.com/*", "https://app.slack.com/*",
      "https://teams.microsoft.com/*", "https://teams.live.com/*", "https://teams.cloud.microsoft/*",
      "https://chat.google.com/*", "https://messages.google.com/*", "https://www.linkedin.com/*",
      "https://www.reddit.com/*", "https://chat.reddit.com/*", "https://www.snapchat.com/*", "https://web.snapchat.com/*"
    ]
  }],
  "commands": {
    "open-picker": { "suggested_key": { "default": "Alt+G" }, "description": "Open the meme picker" }
  }
}
