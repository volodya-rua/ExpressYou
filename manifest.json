{
  "manifest_version": 3,
  "name": "ExpressYou",
  "short_name": "ExpressYou",
  "version": "1.5",
  "description": "Send your own memes, reactions and GIPHY GIFs in one click, right inside Instagram, Discord, WhatsApp, Telegram, X, Slack and more.",
  "homepage_url": "https://github.com/volodya-rua/ExpressYou",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "ExpressYou memes (Alt+G)",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://www.instagram.com/*",
    "https://discord.com/*",
    "https://*.discord.com/*",
    "https://web.whatsapp.com/*",
    "https://web.telegram.org/*",
    "https://www.messenger.com/*",
    "https://www.facebook.com/*",
    "https://x.com/*",
    "https://twitter.com/*",
    "https://app.slack.com/*",
    "https://teams.microsoft.com/*",
    "https://teams.live.com/*",
    "https://teams.cloud.microsoft/*",
    "https://chat.google.com/*",
    "https://messages.google.com/*",
    "https://www.linkedin.com/*",
    "https://www.reddit.com/*",
    "https://chat.reddit.com/*",
    "https://www.snapchat.com/*",
    "https://web.snapchat.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.instagram.com/*",
        "https://discord.com/*",
        "https://*.discord.com/*",
        "https://web.whatsapp.com/*",
        "https://web.telegram.org/*",
        "https://www.messenger.com/*",
        "https://www.facebook.com/*",
        "https://x.com/*",
        "https://twitter.com/*",
        "https://app.slack.com/*",
        "https://teams.microsoft.com/*",
        "https://teams.live.com/*",
        "https://teams.cloud.microsoft/*",
        "https://chat.google.com/*",
        "https://messages.google.com/*",
        "https://www.linkedin.com/*",
        "https://www.reddit.com/*",
        "https://chat.reddit.com/*",
        "https://www.snapchat.com/*",
        "https://web.snapchat.com/*"
      ],
      "js": [
        "paste.js",
        "content.js"
      ]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "popup.html"
      ],
      "matches": [
        "https://www.instagram.com/*",
        "https://discord.com/*",
        "https://*.discord.com/*",
        "https://web.whatsapp.com/*",
        "https://web.telegram.org/*",
        "https://www.messenger.com/*",
        "https://www.facebook.com/*",
        "https://x.com/*",
        "https://twitter.com/*",
        "https://app.slack.com/*",
        "https://teams.microsoft.com/*",
        "https://teams.live.com/*",
        "https://teams.cloud.microsoft/*",
        "https://chat.google.com/*",
        "https://messages.google.com/*",
        "https://www.linkedin.com/*",
        "https://www.reddit.com/*",
        "https://chat.reddit.com/*",
        "https://www.snapchat.com/*",
        "https://web.snapchat.com/*"
      ]
    }
  ],
  "commands": {
    "open-picker": {
      "suggested_key": {
        "default": "Alt+G"
      },
      "description": "Open the meme picker"
    }
  }
}
